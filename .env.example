# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored.

# ---- Anthropic (Claude API) ----
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ---- fal.ai (image / video generation) ----
# Get a key at https://fal.ai/dashboard/keys
FAL_KEY=

# ---- Supabase Postgres ----
# Project Settings -> Database -> Connection string (URI). Replace [YOUR-PASSWORD].
# For production-like load, use the pooler URL on port 6543.
DATABASE_URL=

# ---- Server ----
API_PORT=3001
NODE_ENV=development

# ---- gethookd ad-intelligence API (Ad Console competitor/niche ADS). Empty = ad pulls off. ----
GETHOOKD_API_KEY=
GETHOOKD_BASE_URL=https://app.gethookd.ai
GETHOOKD_CREDIT_RESERVE=50

# ---- LanderLab (Listicle Builder deployment target) ----
# Get the API key at app.landerlab.io -> Settings -> API Keys. Format: ll_live_...
# Workspace ID is the numeric id shown in dashboard URLs.
LANDERLAB_API_KEY=
LANDERLAB_WORKSPACE_ID=
# Optional overrides — defaults match landerlab.dev:
# LANDERLAB_REST_BASE=https://api.landerlab.dev/api/v2
# LANDERLAB_MCP_URL=https://api.landerlab.dev/api/v2/mcp
# LANDERLAB_APP_BASE=https://app.landerlab.io
